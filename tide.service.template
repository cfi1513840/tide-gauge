[Unit]
Description=Tide Station
After=network.target

[Service]
TimeoutSec=5min
ExecStartPre=/bin/sleep 180
Environment=DISPLAY=:0
ExecStart=/home/tide/.tidenv/bin/python3  /home/tide/bin/tidegauge/tide.py
WorkingDirectory=/home/tide/bin/tidegauge
StandardOutput=inherit
StandardError=inherit
User=tide
# Restart tide.py automatically if the process dies with an error
# (an exit code other than 0, or a fatal signal). A deliberate clean
# exit -- e.g. tide.py refusing to start because tidemonitor.py is
# already running -- is NOT restarted. Each restart repeats the
# ExecStartPre 180-second delay above.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
